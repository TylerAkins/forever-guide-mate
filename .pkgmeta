# https://github.com/BigWigsMods/packager
package-as: ForeverGuideMate

manual-changelog:
  filename: RELEASE_NOTES.md
  markup-type: markdown

ignore:
  - .git
  - .github
  - .cursor
  - .gitignore
  - .pkgmeta
  - VERSION
  - docs
  - tests
  - tools
  - AGENTS.md
  - "**/.DS_Store"
  - "**/Thumbs.db"
  - "**/__pycache__"
